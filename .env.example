LLM_PROVIDER=openai
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# Retry policy (RetryingLLMProvider, ADR-007). The provider SDKs do not retry on their own.
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_DEADLINE_SECONDS=100
LLM_RETRY_INITIAL_DELAY_SECONDS=1
LLM_RETRY_MAX_DELAY_SECONDS=5
LLM_RETRY_JITTER=true

# Bounded in-memory metrics/events window exposed at /observability/*
OBSERVABILITY_MAX_RECORDS=10000

OPENAI_API_KEY=

NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b

# RAG Configuration
# Chunking Strategy Options:
#   - recursive: LangChain RecursiveCharacterTextSplitter (semantic-aware, handles varied structure)
#   - markdown: LangChain MarkdownTextSplitter (for markdown docs with code block preservation)
RAG_CHUNKING_STRATEGY=recursive
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50

# Embedding provider for the /rag API: "openai" or "nvidia".
#   openai: key from RAG_EMBEDDING_KEY (falls back to OPENAI_API_KEY); always text-embedding-3-small
#   nvidia: RAG_EMBEDDING_KEY, RAG_EMBEDDING_MODEL and RAG_EMBEDDING_DIMENSION are used
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSION=1536
RAG_EMBEDDING_KEY=
# NVIDIA asymmetric models (e.g. nemotron embed) need input_type query/passage; set false for symmetric models
RAG_EMBEDDING_SEND_INPUT_TYPE=true

# Vector store for the /rag API (QDRANT_URL / QDRANT_API_KEY are accepted as fallbacks)
RAG_VECTOR_STORE=qdrant
# Use :memory: for an in-process Qdrant (local experiments/tests only; data is lost on restart)
RAG_VECTOR_STORE_URL=http://localhost:6333
RAG_VECTOR_STORE_API_KEY=
RAG_VECTOR_STORE_DISTANCE_METRIC=cosine
# One collection per embedding model: vectors from different models are not comparable.
# The collection records the model/dimension it was built with; a mismatch is refused.
RAG_COLLECTION=documents
