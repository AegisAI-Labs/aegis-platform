LLM_PROVIDER=openai
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

OPENAI_API_KEY=

NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b

# RAG Configuration
# Chunking Strategy Options:
#   - recursive: LangChain RecursiveCharacterTextSplitter (semantic-aware, handles varied structure)
#   - markdown: LangChain MarkdownTextSplitter (for markdown docs with code block preservation)
RAG_CHUNKING_STRATEGY=recursive
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50

# Embedding provider for the /rag API: "openai" or "nvidia".
#   openai: key from RAG_EMBEDDING_KEY (falls back to OPENAI_API_KEY); always text-embedding-3-small
#   nvidia: RAG_EMBEDDING_KEY, RAG_EMBEDDING_MODEL and RAG_EMBEDDING_DIMENSION are used
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSION=1536
RAG_EMBEDDING_KEY=

# Vector store for the /rag API (QDRANT_URL / QDRANT_API_KEY are accepted as fallbacks)
RAG_VECTOR_STORE=qdrant
RAG_VECTOR_STORE_URL=http://localhost:6333
RAG_VECTOR_STORE_API_KEY=
RAG_VECTOR_STORE_DISTANCE_METRIC=cosine
